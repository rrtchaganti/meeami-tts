/data/
/runs/
/export/
/logs/
/out/
bundle*.tar.gz

# audio
*.wav
*.WAV
*.mp3
*.flac
*.ogg
*.m4a
*.opus
# edge-case suite is committed (Section 9)
!/tests/edge_cases/**
# live-demo references (L2-ARCTIC test clips, CC BY-NC 4.0; demo/clips/SOURCE.md, D-100)
!/demo/clips/**

# tensorboard
events.out.tfevents.*

# python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# editors / os
.vscode/
.idea/
.DS_Store

# evaluation intermediates (keep per_utt.csv, summary.json, comparison CSVs, plots, profiles)
/results/*/*/wav/
/results/*/*/align_out/
/results/*/*/_out_corpus/
/results/*/*/scores.jsonl
/results/*/*/mfa_out.log
/results/_ref/
/results/_rejected/*/*/wav/
/results/_rejected/*/*/align_out/
/results/_rejected/*/*/scores.jsonl
/results/_rejected/*/*/mfa_out.log
/results/tune/*/*/wav/
/results/tune/*/*/align_out/
/results/tune/*/*/scores.jsonl
/results/_profile_tmp/
/envs/condaenv.*.requirements.txt
# tune grid: keep grid.json, choice.json and each setting's per_utt.csv + summary.json
/results/tune/*/*/*
!/results/tune/*/*/per_utt.csv
!/results/tune/*/*/summary.json
# evidence samples (E-36): exact evaluated outputs + references, built by `make samples`
!/samples/**
